PORT=3001
# Set explicitly for local development; it uses in-memory photo metadata and
# skips RDS migrations. All other environments require RDS configuration.
NODE_ENV=development
# Production database credentials come from AWS Secrets Manager through the local
# AWS Workload Credentials Provider. The secret ID is safe to configure here;
# never place the database password or connection URL in this file.
AWS_DATABASE_SECRET_ID=online-gallery-db-creds
# Production: absolute path to the downloaded RDS CA certificate bundle.
# AWS_RDS_CA_CERTIFICATE_PATH=/etc/ssl/certs/rds-ca.pem

# Set AWS_S3_BUCKET_NAME to persist image data in a private S3-compatible bucket.
# For local development only, the SDK reads the standard AWS credential variables below.
# Do not set them on EC2; use an attached IAM role there instead.

# AWS_S3_BUCKET_NAME=online-gallery-s3
# AWS_S3_KEY_PREFIX=photos
# AWS_S3_ENDPOINT=https://s3.example.com
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_S3_REGION=eu-central-1

# AWS_ACCESS_KEY_ID=your-local-access-key-id
# AWS_SECRET_ACCESS_KEY=your-local-secret-access-key
# AWS_SESSION_TOKEN=your-session-token-if-using-temporary-credentials
